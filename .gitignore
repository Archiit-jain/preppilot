# Dependencies
node_modules/
.pnp.*
.yarn/*

# Build output
dist/
build/
web-build/
*.tsbuildinfo

# Expo
.expo/
.expo-shared/
android/
ios/

# Environment / secrets  (never commit Gemini or Supabase service-role keys)
.env
.env.*
!.env.example
*.pem
*.key

# Supabase local
supabase/.branches/
supabase/.temp/

# Testing
coverage/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code local worktrees & session state (not project source)
.claude/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
# Generated web build
apps/mobile/dis/
# Python bytecode from the docs generators
__pycache__/
*.pyc

# Office lock files, left while a document is open
~$*

# Built theme packs (node supabase/themes/build-themes.mjs); uploaded to Storage, not committed.
supabase/themes/dist/
supabase/templates-library/dist/
